SECRET_KEY=remplace-cette-cle-par-une-vraie-valeur-aleatoire
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SETTINGS_MODULE=config.settings.dev

# Adresse de l'application (lien « mot de passe oublié »)
FRONTEND_URL=http://localhost:5173

# Connexion Google / Apple : laisser vide tant que les comptes développeur ne sont pas créés
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Nombre de proxys de confiance devant Django (0 en local, 1 derrière nginx / l'hébergeur)
NUM_PROXIES=0

# --- Production uniquement (voir docs/SECURITE.md) ---
# ADMIN_URL=gestion-xxxx/            # adresse de l'administration, moins évidente que admin/
# CSRF_TRUSTED_ORIGINS=https://nounou.example
# HSTS_INCLUDE_SUBDOMAINS=False      # True seulement si TOUS les sous-domaines sont en HTTPS
# HSTS_PRELOAD=False
# DB_NAME= / DB_USER= / DB_PASSWORD= / DB_HOST= / DB_SSLMODE=require
# EMAIL_HOST= / EMAIL_PORT=587 / EMAIL_HOST_USER= / EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=NOUNOU+ <no-reply@nounou.example>
